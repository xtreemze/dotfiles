# Safe, non-secret Rclone VFS policy.
# Remote credentials remain in the machine-local rclone.conf managed by Rclone.
RCLONE_CLOUD_REMOTE="cloud:"
RCLONE_CLOUD_MOUNT="$HOME/Cloud"
RCLONE_VFS_CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/rclone/vfs"
RCLONE_VFS_CACHE_MODE="full"
RCLONE_VFS_CACHE_MAX_SIZE="20Gi"
RCLONE_VFS_CACHE_MAX_AGE="168h"
RCLONE_VFS_DIR_CACHE_TIME="10m"
RCLONE_VFS_POLL_INTERVAL="1m"
RCLONE_VFS_READ_AHEAD="128Mi"
RCLONE_VFS_WRITE_BACK="5s"
