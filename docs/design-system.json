{
  "version": 2,
  "color": {
    "site": {
      "mode": "system",
      "description": "GitHub Pages uses the browser's native light/dark color scheme with neutral Canvas/CanvasText surfaces and minimal accent color."
    },
    "terminal": {
      "family": "Everforest",
      "active": {
        "dark": "dark hard",
        "light": "light medium"
      },
      "variants": {
        "darkHard": {
          "label": "Dark hard",
          "background": "#1e2326",
          "foreground": "#d3c6aa",
          "cursor": "#d3c6aa",
          "selectionForeground": "#1e2326",
          "selectionBackground": "#d3c6aa",
          "palette": {
            "black": "#4b565c",
            "red": "#e67e80",
            "green": "#a7c080",
            "yellow": "#dbbc7f",
            "blue": "#7fbbb3",
            "magenta": "#d699b6",
            "cyan": "#83c092",
            "white": "#d3c6aa"
          }
        },
        "darkMedium": {
          "label": "Dark medium",
          "background": "#232a2e",
          "foreground": "#d3c6aa",
          "cursor": "#d3c6aa",
          "selectionForeground": "#232a2e",
          "selectionBackground": "#d3c6aa",
          "palette": {
            "black": "#4b565c",
            "red": "#e67e80",
            "green": "#a7c080",
            "yellow": "#dbbc7f",
            "blue": "#7fbbb3",
            "magenta": "#d699b6",
            "cyan": "#83c092",
            "white": "#d3c6aa"
          }
        },
        "lightHard": {
          "label": "Light hard",
          "background": "#fff9e8",
          "foreground": "#5c6a72",
          "cursor": "#5c6a72",
          "selectionForeground": "#fff9e8",
          "selectionBackground": "#5c6a72",
          "palette": {
            "black": "#5c6a72",
            "red": "#f85552",
            "green": "#8da101",
            "yellow": "#dfa000",
            "blue": "#3a94c5",
            "magenta": "#df69ba",
            "cyan": "#35a77c",
            "white": "#dfddc8"
          }
        },
        "lightMedium": {
          "label": "Light medium",
          "background": "#fdf6e3",
          "foreground": "#5c6a72",
          "cursor": "#5c6a72",
          "selectionForeground": "#fdf6e3",
          "selectionBackground": "#5c6a72",
          "palette": {
            "black": "#5c6a72",
            "red": "#f85552",
            "green": "#8da101",
            "yellow": "#dfa000",
            "blue": "#3a94c5",
            "magenta": "#df69ba",
            "cyan": "#35a77c",
            "white": "#dfddc8"
          }
        }
      }
    }
  },
  "typography": {
    "siteUI": "system-ui",
    "siteCode": "ui-monospace",
    "terminal": "Monaspace Krypton",
    "terminalSize": "14pt",
    "managedAsset": "Monaspace",
    "activeFace": "Monaspace Krypton",
    "familyVariants": [
      {
        "name": "Monaspace Krypton",
        "role": "Active terminal face"
      },
      {
        "name": "Monaspace Neon",
        "role": "Neo-grotesque variant"
      },
      {
        "name": "Monaspace Argon",
        "role": "Humanist variant"
      },
      {
        "name": "Monaspace Xenon",
        "role": "Slab-serif variant"
      },
      {
        "name": "Monaspace Radon",
        "role": "Handwriting-influenced variant"
      }
    ],
    "weights": [
      300,
      400,
      500,
      600,
      700,
      800
    ],
    "styles": [
      "normal",
      "italic"
    ],
    "features": [
      "calt",
      "liga",
      "ss01",
      "ss02",
      "ss03",
      "ss04",
      "ss05",
      "ss06",
      "ss07",
      "ss08",
      "ss09"
    ],
    "specimen": {
      "headline": "The quick brown fox jumps over the lazy dog.",
      "alphabetUpper": "ABCDEFGHIJKLMNOPQRSTUVWXYZ",
      "alphabetLower": "abcdefghijklmnopqrstuvwxyz",
      "numerals": "0123456789 123,456.78 0xDEADBEEF",
      "punctuation": "! ? @ # $ % & * ( ) [ ] { } < > / \\\\ | _ - + = : ; , .",
      "code": "const cloud = await mount('cloud:', { cache: 'full', readAhead: '128Mi' });"
    }
  },
  "interaction": {
    "philosophy": [
      "Keyboard-first",
      "Home-row navigation",
      "Modal-editor safe",
      "Native platform conventions where they do not conflict",
      "Mouse available but secondary"
    ],
    "groups": [
      {
        "id": "tmux",
        "title": "tmux",
        "bindings": [
          [
            "Prefix",
            "Ctrl+Alt+Shift+Space"
          ],
          [
            "Move pane",
            "h / j / k / l"
          ],
          [
            "Resize pane",
            "Shift+h / j / k / l"
          ],
          [
            "Split around current pane",
            "Alt+h / j / k / l"
          ],
          [
            "File picker",
            "Ctrl+t"
          ],
          [
            "Directory picker",
            "Ctrl+g"
          ],
          [
            "Session selector",
            "Shift+s"
          ],
          [
            "Project selector",
            "Shift+p"
          ],
          [
            "Window finder",
            "Shift+f"
          ],
          [
            "Pane finder",
            "."
          ]
        ]
      },
      {
        "id": "ghostty",
        "title": "Ghostty",
        "bindings": [
          [
            "New tab",
            "⌘T"
          ],
          [
            "New split right",
            "⌘D"
          ],
          [
            "New split down",
            "⌘⇧D"
          ],
          [
            "Move between splits",
            "⌘⇧H / J / K / L"
          ],
          [
            "Resize splits",
            "⌘⌃H / J / K / L"
          ],
          [
            "Select tab",
            "⌘1 … ⌘8"
          ],
          [
            "Last tab",
            "⌘9"
          ],
          [
            "Toggle split zoom",
            "⌘⇧Return"
          ],
          [
            "Fullscreen",
            "⌘Return"
          ]
        ]
      },
      {
        "id": "helix",
        "title": "Helix",
        "bindings": [
          [
            "Editor model",
            "Helix modal defaults"
          ],
          [
            "Move selection line down",
            "Alt+J"
          ],
          [
            "Move selection line up",
            "Alt+K"
          ],
          [
            "Duplicate line below",
            "Alt+Shift+J"
          ],
          [
            "Duplicate line above",
            "Alt+Shift+K"
          ],
          [
            "Increment",
            "Ctrl+Shift+A"
          ],
          [
            "Decrement",
            "Ctrl+Shift+X"
          ]
        ]
      },
      {
        "id": "site",
        "title": "Website",
        "bindings": [
          [
            "Catalog tabs",
            "Left / Right arrows"
          ],
          [
            "First / last tab",
            "Home / End"
          ],
          [
            "Theme and language",
            "Native select controls"
          ],
          [
            "Primary navigation",
            "Standard links and focus order"
          ]
        ]
      }
    ]
  }
}
