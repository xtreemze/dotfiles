{
  "$schema": "https://lnav.org/schemas/config-v1.schema.json",
  "ui": {
    "theme-defs": {
      "catppuccin-macchiato": {
        "vars": {
          "rosewater": "#f4dbd6",
          "flamingo": "#f0c6c6",
          "pink": "#f5bde6",
          "mauve": "#c6a0f6",
          "red": "#ed8796",
          "maroon": "#ee99a0",
          "peach": "#f5a97f",
          "yellow": "#eed49f",
          "green": "#a6da95",
          "teal": "#8bd5ca",
          "sky": "#91d7e3",
          "sapphire": "#7dc4e4",
          "blue": "#8aadf4",
          "lavender": "#b7bdf8",
          "text": "#cad3f5",
          "subtext1": "#b8c0e0",
          "subtext0": "#a5adcb",
          "overlay2": "#939ab7",
          "overlay1": "#8087a2",
          "overlay0": "#6e738d",
          "surface2": "#5b6078",
          "surface1": "#494d64",
          "surface0": "#363a4f",
          "base": "#24273a",
          "mantle": "#1e2030",
          "crust": "#181926",
          "semantic_highlight_color": "semantic()"
        },
        "styles": {
          "identifier": {
            "color": "semantic()"
          },
          "text": {
            "color": "$text"
          },
          "selected-text": {
            "background-color": "$sky"
          },
          "alt-text": {
            "background-color": "$mantle"
          },
          "ok": {
            "color": "$green",
            "bold": true
          },
          "info": {
            "color": "$mauve",
            "bold": true
          },
          "error": {
            "color": "$red",
            "bold": true
          },
          "warning": {
            "color": "$yellow",
            "bold": true
          },
          "hidden": {
            "color": "$yellow",
            "bold": true
          },
          "cursor-line": {
            "color": "$blue",
            "background-color": "$surface1",
            "bold": true
          },
          "disabled-cursor-line": {
            "color": "$sky",
            "background-color": "$maroon"
          },
          "adjusted-time": {
            "color": "$mauve"
          },
          "skewed-time": {
            "color": "$yellow"
          },
          "offset-time": {
            "color": "$sky"
          },
          "file-offset": {
            "color": "$overlay2"
          },
          "invalid-msg": {
            "color": "$yellow"
          },
          "focused": {
            "color": "$base",
            "background-color": "$surface1"
          },
          "disabled-focused": {
            "color": "$text",
            "background-color": "$mantle"
          },
          "popup": {
            "color": "$subtext1",
            "background-color": "$overlay0"
          },
          "scrollbar": {
            "color": "$base",
            "background-color": "$text"
          },
          "h1": {
            "color": "$mauve",
            "bold": true
          },
          "h2": {
            "color": "$mauve",
            "underline": true
          },
          "h3": {
            "color": "$mauve"
          },
          "h4": {
            "underline": true
          },
          "h5": {
            "underline": true
          },
          "h6": {
            "underline": true
          },
          "hr": {
            "color": "$surface2"
          },
          "hyperlink": {
            "underline": true
          },
          "list-glyph": {
            "color": "$yellow"
          },
          "breadcrumb": {
            "color": "$overlay1",
            "bold": true
          },
          "table-border": {
            "color": "$surface2"
          },
          "table-header": {
            "bold": true
          },
          "quote-border": {
            "color": "$overlay0",
            "background-color": "$surface0"
          },
          "quoted-text": {
            "color": "$yellow",
            "background-color": "$surface0"
          },
          "footnote-border": {
            "color": "$blue",
            "background-color": "$surface0"
          },
          "footnote-text": {
            "color": "$teal",
            "background-color": "$surface0"
          },
          "snippet-border": {
            "color": "$sky"
          },
          "indent-guide": {
            "color": "$surface2"
          }
        },
        "syntax-styles": {
          "inline-code": {
            "color": "$red",
            "background-color": "$crust"
          },
          "quoted-code": {
            "color": "$text",
            "background-color": "$crust"
          },
          "code-border": {
            "color": "$surface2",
            "background-color": "$crust"
          },
          "keyword": {
            "color": "$yellow"
          },
          "string": {
            "color": "$sky",
            "bold": true
          },
          "comment": {
            "color": "$overlay2"
          },
          "doc-directive": {
            "color": "$sky"
          },
          "variable": {
            "color": "$blue"
          },
          "symbol": {
            "color": "$blue"
          },
          "re-special": {
            "color": "$sky"
          },
          "re-repeat": {
            "color": "$yellow"
          },
          "diff-delete": {
            "color": "$red"
          },
          "diff-add": {
            "color": "$green"
          },
          "diff-section": {
            "color": "$mauve"
          },
          "spectrogram-low": {
            "background-color": "$green"
          },
          "spectrogram-medium": {
            "background-color": "$yellow"
          },
          "spectrogram-high": {
            "background-color": "$red"
          },
          "file": {
            "color": "$blue"
          },
          "null": {
            "color": "$overlay2"
          },
          "ascii-control": {
            "color": "$green"
          },
          "non-ascii": {
            "color": "$yellow"
          },
          "number": {
            "bold": true
          },
          "function": {
            "color": "$sky"
          },
          "separators-references-accessors": {
            "color": "$red"
          },
          "type": {
            "color": "$blue"
          }
        },
        "status-styles": {
          "disabled-title": {
            "color": "$overlay2",
            "background-color": "$base",
            "bold": true
          },
          "title": {
            "color": "$mantle",
            "background-color": "$blue",
            "bold": true
          },
          "subtitle": {
            "color": "$base",
            "background-color": "$sky",
            "bold": true
          },
          "text": {
            "color": "$subtext1",
            "background-color": "$surface1"
          },
          "warn": {
            "color": "$yellow",
            "background-color": "$surface1"
          },
          "alert": {
            "color": "$red",
            "background-color": "$surface1"
          },
          "active": {
            "color": "$green",
            "background-color": "$surface1"
          },
          "inactive": {
            "color": "$subtext0",
            "background-color": "$mantle"
          },
          "inactive-alert": {
            "color": "$red",
            "background-color": "$mantle"
          },
          "suggestion": {
            "color": "$mantle"
          }
        },
        "log-level-styles": {
          "warning": {
            "color": "$yellow"
          },
          "error": {
            "color": "$red"
          },
          "critical": {
            "color": "$red"
          },
          "fatal": {
            "color": "$red"
          }
        }
      }
    }
  }
}
